\
#!/bin/sh
set -eu
BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROP="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"
DIST_URL=$(sed -n 's/^distributionUrl=//p' "$PROP")
MAVEN_VERSION=$(printf '%s' "$DIST_URL" | sed -n 's#.*apache-maven-\([0-9][0-9.]*\)-bin.zip#\1#p')
WRAPPER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}/wrapper/dists/apache-maven-$MAVEN_VERSION"
MVN="$WRAPPER_HOME/apache-maven-$MAVEN_VERSION/bin/mvn"
if [ ! -x "$MVN" ]; then
  mkdir -p "$WRAPPER_HOME"
  ZIP="$WRAPPER_HOME/apache-maven-$MAVEN_VERSION-bin.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$DIST_URL" -o "$ZIP"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$DIST_URL" -O "$ZIP"
  else
    echo "Se requiere curl o wget para descargar Maven Wrapper." >&2; exit 1
  fi
  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$ZIP" -d "$WRAPPER_HOME"
  else
    echo "Se requiere unzip para preparar Maven Wrapper." >&2; exit 1
  fi
  rm -f "$ZIP"
fi
exec "$MVN" "$@"
